# =====================================================================
# EnergyAutomation Streamlit BI Dashboard — Configuration Secrets Template
# Copy this file to .streamlit/secrets.toml for local customization.
# NEVER commit secrets.toml containing private credentials to Git!
# =====================================================================

# Data source mode: "local" (reads local disk file) or "cloud" (downloads from URL)
DATA_SOURCE = "local"

# Local Development / Offline Path
LOCAL_EXCEL_PATH = "Test_BI_Analysis_Report_2026.xlsx"

# Cloud Storage Provider: "google_drive", "onedrive", "dropbox", or "direct_url"
CLOUD_PROVIDER = "google_drive"

# Cloud Sharing URL or Direct Download URL
# Google Drive Example: https://drive.google.com/file/d/YOUR_FILE_ID/view?usp=sharing
# OneDrive Example:     https://1drv.ms/x/s!YourShareId?e=xxxx
# Dropbox Example:      https://www.dropbox.com/s/your_file_id/Report.xlsx?dl=0
# Direct URL Example:   https://your-company.sharepoint.com/.../Report.xlsx
EXCEL_URL = ""

# Workbook Configuration (matches config/settings.json defaults)
WORKSHEET_NAME = "EMS Monitoring Report"
HEADER_ROW = 3
DATE_COLUMN = 2
TOTAL_COLUMN = 18

# Caching & Refresh Intervals
CACHE_TTL_SECONDS = 300           # 5 minutes Streamlit cache duration
REFRESH_INTERVAL_SECONDS = 300    # 5 minutes auto-refresh check
REQUEST_TIMEOUT_SECONDS = 20      # Network request timeout
